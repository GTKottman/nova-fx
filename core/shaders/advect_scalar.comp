#version 450
// MacCormack advection of one cell-centred scalar on a MAC grid.
// Mirrors advect_scalar() in nova_core.c: RK2 back-trace, trilinear sample with min/max clamp,
// then a forward trace for the error-correcting second pass.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(std430, binding = 0) readonly buffer BU { float U[]; };
layout(std430, binding = 1) readonly buffer BV { float V[]; };
layout(std430, binding = 2) readonly buffer BW { float W[]; };
layout(std430, binding = 3) readonly buffer BS { float src[]; };
layout(std430, binding = 4) buffer BH { float hat[]; };
layout(std430, binding = 5) buffer BN { float mn[]; };
layout(std430, binding = 6) buffer BX { float mx[]; };
layout(std430, binding = 7) buffer BO { float dst[]; };

layout(push_constant) uniform PC {
  int nx, ny, nz, pass_;
  float h;  // dt / dx
} pc;

// clamp-to-edge sampling (velocities)
float samp_clamp(int which, int sx, int sy, int sz, vec3 p) {
  p = clamp(p, vec3(0.0), vec3(sx - 1, sy - 1, sz - 1));
  ivec3 b = ivec3(floor(p));
  vec3 t = p - vec3(b);
  float v[8];
  for (int n = 0; n < 8; n++) {
    ivec3 c = b + ivec3(n & 1, (n >> 1) & 1, (n >> 2) & 1);
    c = clamp(c, ivec3(0), ivec3(sx - 1, sy - 1, sz - 1));
    int idx = c.x + sx * (c.y + sy * c.z);
    v[n] = which == 0 ? U[idx] : (which == 1 ? V[idx] : W[idx]);
  }
  return mix(mix(mix(v[0], v[1], t.x), mix(v[2], v[3], t.x), t.y),
             mix(mix(v[4], v[5], t.x), mix(v[6], v[7], t.x), t.y), t.z);
}

vec3 vel_at(vec3 p) {
  return vec3(samp_clamp(0, pc.nx + 1, pc.ny, pc.nz, p - vec3(0.0, 0.5, 0.5)),
              samp_clamp(1, pc.nx, pc.ny + 1, pc.nz, p - vec3(0.5, 0.0, 0.5)),
              samp_clamp(2, pc.nx, pc.ny, pc.nz + 1, p - vec3(0.5, 0.5, 0.0)));
}

vec3 trace(vec3 p, float h) {
  vec3 v1 = vel_at(p);
  vec3 v2 = vel_at(p - 0.5 * h * v1);
  return p - h * v2;
}

// zero-outside sampling of a scalar; also returns the min/max of the 8 corners
float samp_zero(int which, vec3 p, out float lo, out float hi) {
  int sx = pc.nx, sy = pc.ny, sz = pc.nz;
  p = clamp(p, vec3(-1.0), vec3(sx, sy, sz));
  ivec3 b = ivec3(floor(p));
  vec3 t = p - vec3(b);
  float v[8];
  for (int n = 0; n < 8; n++) {
    ivec3 c = b + ivec3(n & 1, (n >> 1) & 1, (n >> 2) & 1);
    bool out_ = any(lessThan(c, ivec3(0))) || c.x >= sx || c.y >= sy || c.z >= sz;
    int idx = c.x + sx * (c.y + sy * c.z);
    v[n] = out_ ? 0.0 : (which == 0 ? src[idx] : hat[idx]);
  }
  lo = v[0]; hi = v[0];
  for (int n = 1; n < 8; n++) { lo = min(lo, v[n]); hi = max(hi, v[n]); }
  return mix(mix(mix(v[0], v[1], t.x), mix(v[2], v[3], t.x), t.y),
             mix(mix(v[4], v[5], t.x), mix(v[6], v[7], t.x), t.y), t.z);
}

void main() {
  ivec3 g = ivec3(gl_GlobalInvocationID);
  if (g.x >= pc.nx || g.y >= pc.ny || g.z >= pc.nz) return;
  int c = g.x + pc.nx * (g.y + pc.ny * g.z);
  vec3 p = vec3(g) + 0.5;
  if (pc.pass_ == 0) {
    vec3 b = trace(p, pc.h);
    float lo, hi;
    hat[c] = samp_zero(0, b - 0.5, lo, hi);
    mn[c] = lo;
    mx[c] = hi;
  } else {
    vec3 f = trace(p, -pc.h);
    float lo, hi;
    float til = samp_zero(1, f - 0.5, lo, hi);
    float val = hat[c] + 0.5 * (src[c] - til);
    val = (val < mn[c] || val > mx[c]) ? hat[c] : val;
    dst[c] = max(val, 0.0);
  }
}
